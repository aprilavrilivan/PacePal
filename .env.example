# Public application URL. Keep blank during local development.
NEXT_PUBLIC_APP_URL=

# Supabase browser credentials. The publishable key is safe to expose when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The foundation defaults to deterministic mock behavior.
# Supported values: mock, openai
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai. Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=
