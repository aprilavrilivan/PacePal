# Public application URL. Keep blank during local development.
NEXT_PUBLIC_APP_URL=

# Supabase browser credentials. The publishable key is safe to expose when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The foundation defaults to deterministic mock behavior.
# Supported values: mock, gateway
AI_PROVIDER=mock

# Optional for local AI Gateway testing. Vercel production uses automatic OIDC.
AI_GATEWAY_API_KEY=
