# Public application URL. Keep blank during local development.
NEXT_PUBLIC_APP_URL=

# Supabase browser credentials. The publishable key is safe to expose when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PacePal uses only DeepSeek V4.1 Flash 1017 through AI Gateway.
# Required for local testing. Vercel production uses automatic OIDC.
AI_GATEWAY_API_KEY=
