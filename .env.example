# Public application URL. Keep blank during local development.
NEXT_PUBLIC_APP_URL=

# Supabase browser credentials. The publishable key is safe to expose when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The foundation defaults to deterministic mock behavior.
# Supported values: mock, gateway
AI_PROVIDER=mock

# Optional for local AI Gateway testing. Vercel production uses automatic OIDC.
AI_GATEWAY_API_KEY=

# Optional but recommended in production. PacePal sends planning requests to
# this single Gemini model through the Google Developer API.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite
